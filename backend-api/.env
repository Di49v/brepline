# Copy this file to ".env" and fill it in.

# REQUIRED: your Cloudflare tunnel URL from Kaggle, must end with /v1
MODEL_URL=https://bumper-muze-undertake-controlling.trycloudflare.com/v1

# OPTIONAL: leave empty to auto-detect from /v1/models
MODEL_NAME=

# OPTIONAL: only if your Kaggle model server requires an API key
MODEL_API_KEY=

# OPTIONAL: requests per minute per key (default 10)
RATE_LIMIT=10

# OPTIONAL: max length of each answer (default 200)
MAX_TOKENS=200
