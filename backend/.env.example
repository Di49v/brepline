# Application Environment
ENVIRONMENT=development

# Comma-separated list of production frontend domains. Ignored if ENVIRONMENT=development.
ALLOWED_ORIGINS=http://localhost:5173,https://brepline.vercel.app,https://www.brepline.com

# API Security
ACCESS_CODE=
ADMIN_TOKEN=change-me-to-a-random-string

# Agent 0 & 1: Planners (Lightning Fast Cloud Open-Source via Groq)
PLAN_BASE_URL=https://api.groq.com/openai/v1
PLAN_API_KEY=gsk_your_groq_api_key_here
PLAN_MODEL=openai/gpt-oss-120b

# Fallback Local Reasoning (If Groq fails)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b

# Agent 2: Coding Model (Teammate's Cluster Link)
CODER_BASE_URL=https://<link-temporary>.trycloudflare.com/v1
CODER_API_KEY=cluster_secret_if_any_not_reqd
CODER_MODEL=brepline

# Job & Execution Constraints
RATE_PER_HOUR=30
MAX_CONCURRENT_JOBS=2
CAD_WORKERS=2
OUT_DIR=/tmp/cad_out
CAD_MEM_MB=4096
CAD_TIMEOUT=180

# Supabase Database
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SERVICE_KEY=[YOUR_SECRET_SERVICE_ROLE_KEY]

# LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=brepline_whatever