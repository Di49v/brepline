# Application Environment
ENVIRONMENT=development
# Comma-separated list of production frontend domains. Ignored if ENVIRONMENT=development.
ALLOWED_ORIGINS=https://brepline.vercel.app,https://www.brepline.com

# API Security
ACCESS_CODE=
ADMIN_TOKEN=super_secret_admin_token

# Job Constraints
RATE_PER_HOUR=30
MAX_CONCURRENT_JOBS=2
CAD_WORKERS=2

# LLM Configuration
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o
LLM_MODE=chat

# Supabase Database (Same for dev/prod for now)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key