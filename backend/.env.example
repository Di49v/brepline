# Application Environment
ENVIRONMENT=development

# Comma-separated list of production frontend domains. Ignored if ENVIRONMENT=development.
ALLOWED_ORIGINS=https://brepline.vercel.app,https://www.brepline.com

# API Security
ACCESS_CODE=
ADMIN_TOKEN=super_secret_admin_token

# Job Constraints
RATE_PER_HOUR=30
MAX_CONCURRENT_JOBS=2
CAD_WORKERS=2

# LLM Configuration (Point to Ollama/vLLM for local open-source during hackathon)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b

# Coding Model (Agent 2) - Teammate's Cluster Link
CODER_BASE_URL=https://<teammates-temporary-link>.ngrok.io/v1
CODER_API_KEY=cluster_secret_if_any
CODER_MODEL=fine-tuned-deepcad

# Supabase Database Connection
# Use the REST URL and the SECRET service_role key for backend operations
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SERVICE_KEY=[YOUR_SECRET_SERVICE_ROLE_KEY]