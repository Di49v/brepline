# Application Environment
ENVIRONMENT=development

# Comma-separated list of production frontend domains. Ignored if ENVIRONMENT=development.
ALLOWED_ORIGINS=http://localhost:5173,https://brepline.vercel.app,https://www.brepline.com

# API Security
ACCESS_CODE=
ADMIN_TOKEN=change-me-to-a-random-string

# 1. Google Gemini API (Agents 0, 2A, Embeddings & Coder Fallbacks)
# Supports single key or comma-separated key pool for multi-model sharding
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_KEY_HERE
GEMINI_API_KEYS=AIzaSy_YOUR_GEMINI_KEY_HERE,AIzaSy_ANOTHER_KEY_HERE
INTENT_MODEL=gemini-3.5-flash-lite
MODIFIER_MODEL=gemma-4-31b-it
CODER_FALLBACK_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2

# 2. Groq Cloud (Agent 1: Specifier / BOM Planner)
# Supports single key or comma-separated key pool
PLAN_BASE_URL=https://api.groq.com/openai/v1
PLAN_API_KEY=gsk_YOUR_GROQ_KEY_HERE
PLAN_API_KEYS=gsk_YOUR_GROQ_KEY_HERE,gsk_ANOTHER_KEY_HERE
PLAN_MODEL=openai/gpt-oss-120b

# 3. Teammate's Cluster Link (Agent 2B: Primary Atomic Coder)
CODER_BASE_URL=https://librarian-exec-memo-philosophy.trycloudflare.com/v1
CODER_API_KEY=cluster_secret_if_any
CODER_MODEL=brepline

# 4. Local Ollama Fallback (Used only if Cloud APIs are unconfigured)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_MODE=chat

# Job & Execution Constraints
RATE_PER_HOUR=30
MAX_CONCURRENT_JOBS=2
CAD_WORKERS=2
OUT_DIR=/tmp/cad_out
CAD_MEM_MB=4096
CAD_TIMEOUT=180

# Supabase Database
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SECRET_KEY=[YOUR_SECRET_KEY]

# LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=brepline_multi_agent

# Dual-write replica destination (Teammate's account)
LANGSMITH_RUNS_ENDPOINTS='[{"api_url": "https://api.smith.langchain.com", "api_key": "lsv2_pt_teammate_api_key_here", "project_name": "brepline_multi_agent"}]'